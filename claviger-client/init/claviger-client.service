[Unit]
Description=Claviger Zero Trust Gateway
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# NOTE: Replace 'daemon' with whatever command starts your background engine
ExecStart=/usr/bin/claviger-client daemon
Restart=on-failure
RestartSec=5
User=root

# --- Zero Trust Hardening ---
# Restrict the daemon to ONLY the capabilities it needs to manage networking
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target