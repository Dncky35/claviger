{{ define "tab_homeserver" }}
<div id="tab-homeserver" class="space-y-6 hidden animate-fade-in">
    <div>
        <h2 class="text-3xl font-bold text-slate-100 tracking-tight">Homeserver & Edge Infrastructure</h2>
        <p class="text-muted-foreground text-sm mt-1">Manage local network resilience, automated self-healing, and secure zero-trust edge routing.</p>
    </div>

    <!-- Global Docker Warning Banner (Hidden by default, shown via JS if Docker is offline) -->
    <div id="network-docker-warning" class="hidden bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 flex items-center gap-3 text-amber-400 text-sm">
        <span>⚠️</span>
        <p>Docker service is currently offline or unreachable. Core infrastructure components cannot be managed until Docker is running.</p>
    </div>

    <div class="grid grid-cols-1 gap-6">

        <!-- 1. NETWORK PERSISTENCE & IP WATCHDOG CARD -->
        <div class="bg-surface rounded-2xl border border-border p-6 shadow-sm flex flex-col md:flex-row items-start justify-between gap-6 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-3xl -mr-10 -mt-10 pointer-events-none"></div>
            <div class="z-10 flex-1">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 bg-indigo-500/10 rounded-lg flex items-center justify-center text-indigo-400 text-xl">📡</div>
                    <h3 class="text-lg font-bold text-slate-100">IP Watchdog & Self-Healing</h3>
                    <span id="badge-watchdog-status" class="px-2.5 py-0.5 text-[10px] uppercase font-bold rounded-full bg-slate-800 text-slate-400 border border-slate-700">Checking...</span>
                </div>
                <p class="text-muted-foreground text-sm max-w-2xl mb-4">
                    Monitors your local IP address for unexpected DHCP changes (such as after power outages or router reboots) and updates dependent records.
                </p>
                <div class="flex items-center gap-3">
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="toggle-ip-watchdog" onchange="toggleIPWatchdog(this)" class="sr-only peer">
                        <div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary border border-slate-700"></div>
                    </label>
                    <span class="text-xs font-medium text-slate-300" id="label-watchdog-toggle-text">Enable Local IP Watchdog</span>
                </div>
            </div>
        </div>

        <!-- 2. CLOUDFLARE TUNNEL (CLOUDFLARED) CARD -->
        <div class="bg-surface rounded-2xl border border-border p-6 shadow-sm flex flex-col md:flex-row items-start justify-between gap-6 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-3xl -mr-10 -mt-10 pointer-events-none"></div>
            <div class="z-10 flex-1">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 bg-sky-500/10 rounded-lg flex items-center justify-center text-sky-400 text-xl">☁️</div>
                    <h3 class="text-lg font-bold text-slate-100">Cloudflare Tunnel</h3>
                    <span id="badge-app-cloudflared" class="px-2.5 py-0.5 text-[10px] uppercase font-bold rounded-full bg-slate-800 text-slate-400 border border-slate-700">Checking...</span>
                </div>
                <p class="text-muted-foreground text-sm max-w-2xl mb-4">
                    Securely route traffic from Cloudflare's global edge directly to your local containers behind zero open firewall ports.
                </p>

                <!-- Token Input Drawer (Appears when configuring) -->
                <div id="wrapper-token-cloudflared" class="hidden flex flex-col sm:flex-row gap-2 max-w-md mt-3">
                    <input type="password" id="input-tunnel-token" placeholder="Paste Cloudflare Tunnel Token..." class="bg-slate-900 border border-slate-700 text-slate-100 text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-primary flex-1" />
                    <button onclick="installCloudflaredWithToken()" class="px-4 py-2 bg-primary hover:bg-emerald-600 text-white text-sm font-medium rounded-lg transition-colors shadow-sm">
                        Deploy Tunnel
                    </button>
                </div>
            </div>
            <div class="z-10 flex flex-col items-end shrink-0 gap-2">
                <button id="btn-install-cloudflared" onclick="toggleCloudflareTokenInput()" class="hidden px-4 py-2 bg-primary hover:bg-emerald-600 text-white text-sm font-medium rounded-lg transition-colors shadow-sm shadow-primary/20">
                    Configure & Install
                </button>
            </div>
        </div>

    </div>

    <script>
        // --- 1. SYNC WATCHDOG STATE ---
        async function fetchWatchdogState() {
            try {
                const res = await fetch('/api/network/watchdog');
                if (!res.ok) return;
                const data = await res.json();
                
                const toggle = document.getElementById('toggle-ip-watchdog');
                const badge = document.getElementById('badge-watchdog-status');
                
                toggle.checked = data.enabled;
                if (data.enabled) {
                    badge.innerText = 'Active';
                    badge.className = 'px-2.5 py-0.5 text-[10px] uppercase font-bold rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
                } else {
                    badge.innerText = 'Disabled';
                    badge.className = 'px-2.5 py-0.5 text-[10px] uppercase font-bold rounded-full bg-slate-800 text-slate-400 border border-slate-700';
                }
            } catch (e) {
                console.error("Failed to fetch watchdog state:", e);
            }
        }

        async function toggleIPWatchdog(checkbox) {
            const isEnabled = checkbox.checked;
            try {
                const res = await fetch('/api/network/watchdog', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enable: isEnabled })
                });
                if (res.ok) {
                    fetchWatchdogState();
                } else {
                    alert('Failed to update IP Watchdog settings.');
                    checkbox.checked = !isEnabled;
                }
            } catch (e) {
                console.error(e);
                alert('Network error while updating watchdog.');
                checkbox.checked = !isEnabled;
            }
        }

        // --- 2. TOGGLE CLOUDFLARE TOKEN DRAWER ---
        function toggleCloudflareTokenInput() {
            const wrapper = document.getElementById('wrapper-token-cloudflared');
            wrapper.classList.toggle('hidden');
        }

        // --- 3. INSTALL CLOUDFLARED WITH TOKEN ---
        async function installCloudflaredWithToken() {
            const tokenInput = document.getElementById('input-tunnel-token');
            const token = tokenInput.value.trim();
            if (!token) {
                alert('Please enter a valid Cloudflare Tunnel token.');
                return;
            }

            try {
                const res = await fetch('/api/apps/install', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ app: 'cloudflared', custom_token: token })
                });
                if (res.ok) {
                    alert('Cloudflare Tunnel deployment initiated successfully!');
                    toggleCloudflareTokenInput();
                    checkDockerForNetworkTab();
                } else {
                    const err = await res.text();
                    alert('Failed to deploy tunnel: ' + err);
                }
            } catch (e) {
                console.error(e);
                alert('Network error during deployment.');
            }
        }

        // --- 4. CHECK DOCKER & CONTAINER STATES FOR TAB ---
        async function checkDockerForNetworkTab() {
            fetchWatchdogState();
            try {
                const res = await fetch('/api/containers');
                if (!res.ok) return;
                const data = await res.json();
                
                if (!data.docker_installed) {
                    document.getElementById('network-docker-warning').classList.remove('hidden');
                    const btn = document.getElementById('btn-install-cloudflared');
                    if (btn) {
                        btn.classList.remove('hidden');
                        btn.disabled = true;
                        btn.innerText = 'Docker Required';
                        btn.className = 'px-4 py-2 bg-slate-800 text-slate-500 text-sm font-medium rounded-lg border border-slate-700 cursor-not-allowed';
                    }
                    return;
                }

                const runningContainers = data.containers || [];
                
                // Cloudflared State Check
                const isCloudflaredRunning = runningContainers.some(c => c.name === 'claviger-cloudflared' && c.state === 'running');
                const badgeCloudflared = document.getElementById('badge-app-cloudflared');
                const btnInstallCloudflared = document.getElementById('btn-install-cloudflared');

                if (isCloudflaredRunning) {
                    badgeCloudflared.innerText = 'Online';
                    badgeCloudflared.className = 'px-2.5 py-0.5 text-[10px] uppercase font-bold rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
                    btnInstallCloudflared.classList.add('hidden');
                    document.getElementById('wrapper-token-cloudflared').classList.add('hidden');
                } else {
                    badgeCloudflared.innerText = 'Offline';
                    badgeCloudflared.className = 'px-2.5 py-0.5 text-[10px] uppercase font-bold rounded-full bg-slate-800 text-slate-400 border border-slate-700';
                    btnInstallCloudflared.classList.remove('hidden');
                }

            } catch (e) {
                console.error("Failed to check container statuses for homeserver tab:", e);
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            checkDockerForNetworkTab();
        });
    </script>
</div>
{{ end }}